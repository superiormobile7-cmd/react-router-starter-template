{
  "standard": "global-locale-kit/v1",
  "translation": {
    "runtimeMachineTranslation": false,
    "workersAiTranslationBinding": false
  },
  "required": {
    "languageAndRegionSetup": true,
    "userCanChangeLocaleInSettings": true,
    "persistToUserProfile": "required before production release",
    "applyDocumentLangAndDirection": true,
    "localeAwareFormatting": ["date", "number", "currency"],
    "approvedMessagePacksOnly": true,
    "noGeolocationAutoSelection": true
  },
  "qualityGates": {
    "everyAdvertisedLocaleHasApprovedPack": true,
    "rtlVisualTestsWhenAdvertised": true,
    "accessibilityTestForSelector": true,
    "missingPackBlocksLocaleAdvertisement": true
  }
}
